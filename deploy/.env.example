# Скопируйте в deploy/.env и заполните. Файл .env в Git не попадает.

# --- Порт, на котором стенд виден снаружи ---
WEB_PORT=8080

# --- PostgreSQL ---
POSTGRES_DB=priznanie_zaslug
POSTGRES_USER=priznanie
POSTGRES_PASSWORD=

# --- JWT ---
# Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Адрес, с которого открывают фронтенд (нужен, только если он вынесен
#     на другой домен, чем API) ---
CORS_ORIGIN=http://localhost:8080

TZ=Asia/Almaty
