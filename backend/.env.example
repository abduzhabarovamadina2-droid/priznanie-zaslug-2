# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env в Git не попадает — он в .gitignore.

# Подключение к PostgreSQL
DATABASE_URL=postgresql://postgres:ПАРОЛЬ@localhost:5432/priznanie_zaslug

# Порт HTTP-сервера
PORT=4000

# development | production | test
NODE_ENV=development

# Секрет для подписи JWT. Обязателен: без него вход отвечает 503,
# а при NODE_ENV=production сервер не запустится вовсе.
# Сгенерировать длинную случайную строку, например:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Срок жизни токена
JWT_EXPIRES_IN=8h

# Разрешённые источники для CORS, через запятую
CORS_ORIGIN=http://localhost:8010

# Пути к исходным данным для сидов (относительно папки backend)
SEED_EMPLOYEES_PATH=../frontend/employees.json
SEED_RATINGS_PATH=../frontend/Рейтинг.json

# ---------- Вложения (этап 5) ----------
# Папка, куда складываются файлы заявок. По умолчанию backend/uploads.
UPLOAD_DIR=
# Максимальный размер одного файла, МБ
UPLOAD_MAX_MB=10
# Сколько файлов можно приложить к одной заявке
UPLOAD_MAX_PER_REQUEST=5

# ---------- Почта (этап 5) ----------
# Пока MAIL_HOST пуст, письма не уходят: уведомление создаётся, помечается
# отправленным и печатается в лог. Очередь и счётчик попыток при этом
# работают по-настоящему — включение почты не потребует правок кода.
MAIL_HOST=
MAIL_PORT=25
MAIL_SECURE=0
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Признание заслуг <no-reply@nationalbank.kz>
# Перехват на стенде: все письма уйдут на этот адрес вместо настоящих.
MAIL_REDIRECT_TO=
MAIL_BATCH=20
# Разбирать очередь автоматически (0 — только вручную через /notifications/flush)
MAIL_SCHEDULER=1
# Шаг разбора очереди, мин
MAIL_INTERVAL_MIN=5
MAIL_MAX_ATTEMPTS=3

# ---------- Ограничение попыток входа (этап 6) ----------
# Сколько неудачных попыток подряд допускается по паре «логин + адрес»
LOGIN_MAX_FAILS=5
# За какое время они считаются, мин
LOGIN_WINDOW_MIN=15
# На сколько блокируется вход после превышения, мин
LOGIN_BLOCK_MIN=15
