{
  "name": "priznanie-zaslug-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend модуля «Признание заслуг» — Node.js + Express + PostgreSQL",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:status": "node scripts/migrate.js status",
    "db:seed": "node seeds/seed-employees.js",
    "db:seed:users": "node seeds/seed-users.js",
    "db:seed:ratings": "node seeds/seed-ratings.js",
    "db:seed:all": "npm run db:seed && npm run db:seed:users && npm run db:seed:ratings && npm run db:seed:merits && npm run db:seed:refs",
    "db:seed:merits": "node seeds/seed-merits.js",
    "db:rank": "node scripts/recompute-ranks.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "db:seed:refs": "node seeds/seed-refs.js",
    "db:departments": "node scripts/build-departments.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
